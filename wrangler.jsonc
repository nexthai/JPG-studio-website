{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jpg-studio",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/src/*",
      "/assets/*",
      "/images/*"
    ]
  }
}
